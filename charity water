@import url('https://fonts.googleapis.com/css?family=Ryman+Eco:400,700&display=swap');

body {
  margin: 0;
  font-family: 'Ryman Eco', 'Segoe UI', Arial, sans-serif;
  background: linear-gradient(135deg, #e3fcec 0%, #eaf6fb 100%);
  color: #253c29;
  min-height: 100vh;
  letter-spacing: 0.01em;
}

.hero {
  position: relative;
  background: url('https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1350&q=80') no-repeat center center/cover;
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #fff;
  overflow: hidden;
}

.hero-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(34, 139, 87, 0.7); /* eco-friendly deep green overlay */
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 750px;
  padding: 40px 20px;
  margin-top: 50px;
}

.logo {
  display: flex;
  justify-content: center;
  margin-bottom: 2rem;
}

.logo img {
  max-height: 90px;
  width: auto;
  filter: drop-shadow(0px 2px 8px rgba(34,139,87,0.15));
}

.headline {
  font-size: 2.8rem;
  font-family: 'Ryman Eco', serif;
  font-weight: 700;
  margin-bottom: 1.2rem;
  line-height: 1.15;
  color: #f6ffde;
  text-shadow: 0 2px 8px rgba(51, 83, 73, 0.18);
}

.subline {
  font-size: 1.3rem;
  font-family: 'Ryman Eco', serif;
  margin-bottom: 2.2rem;
  color: #e3ffe1;
  line-height: 1.4;
  text-shadow: 0 1px 6px rgba(51, 83, 73, 0.12);
}

.cta-btn {
  display: inline-block;
  background: linear-gradient(90deg, #63c8a0 0%, #45aee0 100%);
  color: #fff;
  padding: 1em 2.1em;
  border: none;
  border-radius: 32px;
  font-family: 'Ryman Eco', serif;
  font-size: 1.15rem;
  font-weight: 700;
  text-decoration: none;
  box-shadow: 0 4px 14px rgba(32, 78, 62, 0.16);
  cursor: pointer;
  transition: background 0.18s, transform 0.18s;
  letter-spacing: 0.03em;
}

.cta-btn:hover {
  background: linear-gradient(90deg, #388e3c 0%, #00897b 100%);
  transform: translateY(-2px) scale(1.03);
}

@media (max-width: 600px) {
  .headline { font-size: 1.5rem; }
  .subline { font-size: 1.05rem; }
  .hero-content { padding: 30px 10px; }
  .logo img { max-height: 60px; }
}
// Water Splash Navigation + Light Burst for Goals Section

document.addEventListener('DOMContentLoaded', function () {
  const links = document.querySelectorAll('.nav-link');
  const sections = document.querySelectorAll('.tab-section');
  const splash = document.createElement('div');
  splash.id = 'water-splash';
  document.body.appendChild(splash);

  // Light burst for Goals section
  const lightBurst = document.createElement('div');
  lightBurst.id = 'light-burst';
  document.body.appendChild(lightBurst);

  // Add splash and light burst styles dynamically if not in CSS
  const extraStyle = document.createElement('style');
  extraStyle.textContent = `
    #water-splash {
      position: fixed;
      left: 50%;
      top: 50%;
      width: 0;
      height: 0;
      background: radial-gradient(circle, #4FC3F7 60%, #0288D1 100%);
      border-radius: 50%;
      pointer-events: none;
      opacity: 0.7;
      z-index: 2000;
      transition: width 0.5s ease, height 0.5s ease, opacity 0.5s ease;
    }
    #water-splash.splash-active {
      width: 250vw;
      height: 250vw;
      left: -75vw;
      top: -75vw;
      opacity: 0.9;
      transition: width 0.5s cubic-bezier(.79,.14,.15,.86), height 0.5s cubic-bezier(.79,.14,.15,.86), opacity 0.4s;
    }
    #light-burst {
      position: fixed;
      top: 50%;
      left: 50%;
      width: 0;
      height: 0;
      background: radial-gradient(circle, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.0) 65%);
      pointer-events: none;
      border-radius: 50%;
      opacity: 1;
      transform: translate(-50%, -50%);
      z-index: 3000;
      transition:
        width 0.5s cubic-bezier(.79,.14,.15,.86),
        height 0.5s cubic-bezier(.79,.14,.15,.86),
        opacity 0.4s;
    }
    #light-burst.active {
      width: 270vw;
      height: 270vw;
      opacity: 0;
      transition:
        width 0.5s cubic-bezier(.79,.14,.15,.86),
        height 0.5s cubic-bezier(.79,.14,.15,.86),
        opacity 0.7s 0.05s;
    }
  `;
  document.head.appendChild(extraStyle);

  // Hide all sections except first
  function showSection(targetId) {
    sections.forEach(sec => {
      if (sec.id === targetId) {
        sec.style.display = 'block';
      } else {
        sec.style.display = 'none';
        sec.classList.remove('showing');
      }
    });
  }
  showSection(sections[0].id);

  links.forEach(link => {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      const targetId = link.getAttribute('data-target');

      if (targetId === 'goals') {
        // Light burst effect for goals
        lightBurst.classList.add('active');
        setTimeout(() => {
          showSection(targetId);
          // Animate goals list
          const goalsSection = document.getElementById('goals');
          goalsSection.classList.add('showing');
          lightBurst.classList.remove('active');
        }, 450); // duration matches CSS transition
      } else {
        // Water splash effect for other sections
        splash.classList.add('splash-active');
        setTimeout(() => {
          showSection(targetId);
          splash.classList.remove('splash-active');
        }, 500);
      }
    });
  });

  // If landing on page with #goals in URL, trigger animation
  if (window.location.hash === '#goals') {
    setTimeout(() => {
      showSection('goals');
      const goalsSection = document.getElementById('goals');
      goalsSection.classList.add('showing');
    }, 300);
  }
});
